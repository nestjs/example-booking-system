DATABASE_URL=postgres://postgres:booking@localhost:5432/booking
# At least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional, with their defaults:
# PORT=3000
# NODE_ENV=development
# Browser origins allowed to call the API, comma-separated (none by default):
# CORS_ORIGINS=http://localhost:5173

# NestJS Observe: `npx @nestjs/observe link` writes OBSERVE_APP_KEY and
# OBSERVE_APP_SECRET here. Without them, the SDK sends nothing.
